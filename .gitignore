.venv/
.venv-*/
.claude/
.git/
data/
runs/
logs/
# Raw generations stay out; the report artifacts the paper's numbers trace to
# come IN. paper_numbers.json points at results/diag/**, so keeping that
# ignored would mean "every number traces to an artifact" was only true of a
# bundle nobody has seen. A reviewer clones the repo, not the bundle.
results/*
!results/diag/
*.log
*.npy
__pycache__/
.pytest_cache/
*.safetensors
*.pyc
.ruff_cache/
.coverage
.sync-state
publication_strategy.md
research_landscape.md

.DS_Store

# LaTeX build artifacts. The .tex and the built .pdf are tracked; the
# intermediates are not -- they churn on every rebuild and carry no information.
*.aux
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz
*.egg-info/
build/
dist/
scratch/
