\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Onset-aligned per-step TV between full and compressed teacher-forced replay (800 profiles). Entries are means of per-trace window means (each trace counts once, matching the problem-clustered convention); the step-pooled later-window mean is \emph  {larger} ($0.118$), because longer traces diverge more.}}{17}{table.caption.12}\protected@file@percent }
\newlabel{tab:tv}{{4}{17}{Onset-aligned per-step TV between full and compressed teacher-forced replay (800 profiles). Entries are means of per-trace window means (each trace counts once, matching the problem-clustered convention); the step-pooled later-window mean is \emph {larger} ($0.118$), because longer traces diverge more}{table.caption.12}{}}
\newlabel{tab:tv@cref}{{[table][4][]4}{[1][15][]17}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Onset-aligned mean per-step TV over 800 replay profiles: exactly zero before the first eviction, near-zero immediately after, then a compounding staircase whose steps align with eviction events (every 64 decoding steps) --- slow drift, not an instantaneous readout error. The curve is shown to $+400$ steps of onset; the later-steps windowed mean of $0.0884$ (\cref  {tab:tv}, per-trace estimator; step-pooled $0.118$) covers the full horizon, where divergence continues to grow.}}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:tvprofile}{{4}{17}{Onset-aligned mean per-step TV over 800 replay profiles: exactly zero before the first eviction, near-zero immediately after, then a compounding staircase whose steps align with eviction events (every 64 decoding steps) --- slow drift, not an instantaneous readout error. The curve is shown to $+400$ steps of onset; the later-steps windowed mean of $0.0884$ (\cref {tab:tv}, per-trace estimator; step-pooled $0.118$) covers the full horizon, where divergence continues to grow}{figure.caption.13}{}}
\newlabel{fig:tvprofile@cref}{{[figure][4][]4}{[1][15][]17}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Answer-distribution distortion at budget 256. Within-answered TV is over renormalized answered-only distributions (a channel diagnostic, not an additive part of ADD). Signed flip-mass is net gained-minus-lost correct-answer mass; all four policies are overwhelmingly on the losing side. ADD values far exceed the $\approx 0.07$ negative-control noise floor (\cref  {sec:control}).}}{18}{table.caption.14}\protected@file@percent }
\newlabel{tab:add}{{5}{18}{Answer-distribution distortion at budget 256. Within-answered TV is over renormalized answered-only distributions (a channel diagnostic, not an additive part of ADD). Signed flip-mass is net gained-minus-lost correct-answer mass; all four policies are overwhelmingly on the losing side. ADD values far exceed the $\approx 0.07$ negative-control noise floor (\cref {sec:control})}{table.caption.14}{}}
\newlabel{tab:add@cref}{{[table][5][]5}{[1][16][]18}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Two failure styles that headline accuracy conflates, split along the recoverable-vs-concentrated line: both concentrated policies are nearly all within-answered (StreamingLLM $0.749$ of ADD $0.751$; H2O-style $0.713$ of $0.715$) --- silent answer flips --- while Random and R-KV carry larger termination-mass shifts ($+0.224$ and $+0.149$). R-KV's ADD is the lowest of the four ($0.459$), coherent with its highest free-running accuracy; flip-mass is overwhelmingly toward lost correct answers for all four. Dashed line marks the two-FC noise floor ($0.068$).}}{18}{figure.caption.15}\protected@file@percent }
\newlabel{fig:add}{{5}{18}{Two failure styles that headline accuracy conflates, split along the recoverable-vs-concentrated line: both concentrated policies are nearly all within-answered (StreamingLLM $0.749$ of ADD $0.751$; H2O-style $0.713$ of $0.715$) --- silent answer flips --- while Random and R-KV carry larger termination-mass shifts ($+0.224$ and $+0.149$). R-KV's ADD is the lowest of the four ($0.459$), coherent with its highest free-running accuracy; flip-mass is overwhelmingly toward lost correct answers for all four. Dashed line marks the two-FC noise floor ($0.068$)}{figure.caption.15}{}}
\newlabel{fig:add@cref}{{[figure][5][]5}{[1][17][]18}{}{}{}}
