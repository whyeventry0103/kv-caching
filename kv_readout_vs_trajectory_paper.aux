\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Onset-aligned mean per-step TV over 800 replay profiles: exactly zero before the first eviction, near-zero immediately after, then a compounding staircase whose steps align with eviction events (every 64 decoding steps) --- slow drift, not an instantaneous readout error. The curve is shown to $+400$ steps of onset; the later-steps windowed mean of $0.0884$ (\cref  {tab:tv}, per-trace estimator; step-pooled $0.118$) covers the full horizon, where divergence continues to grow.}}{14}{figure.caption.10}\protected@file@percent }
\newlabel{fig:tvprofile}{{4}{14}{Onset-aligned mean per-step TV over 800 replay profiles: exactly zero before the first eviction, near-zero immediately after, then a compounding staircase whose steps align with eviction events (every 64 decoding steps) --- slow drift, not an instantaneous readout error. The curve is shown to $+400$ steps of onset; the later-steps windowed mean of $0.0884$ (\cref {tab:tv}, per-trace estimator; step-pooled $0.118$) covers the full horizon, where divergence continues to grow}{figure.caption.10}{}}
\newlabel{fig:tvprofile@cref}{{[figure][4][]4}{[1][12][]14}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Answer-distribution distortion at budget 256. Within-answered TV is over renormalized answered-only distributions (a channel diagnostic, not an additive part of ADD). Signed flip-mass is net gained-minus-lost correct-answer mass; all four policies are overwhelmingly on the losing side. ADD values far exceed the $\approx 0.07$ negative-control noise floor (\cref  {sec:control}).}}{14}{table.caption.11}\protected@file@percent }
\newlabel{tab:add}{{4}{14}{Answer-distribution distortion at budget 256. Within-answered TV is over renormalized answered-only distributions (a channel diagnostic, not an additive part of ADD). Signed flip-mass is net gained-minus-lost correct-answer mass; all four policies are overwhelmingly on the losing side. ADD values far exceed the $\approx 0.07$ negative-control noise floor (\cref {sec:control})}{table.caption.11}{}}
\newlabel{tab:add@cref}{{[table][4][]4}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Two failure styles that headline accuracy conflates, split along the recoverable-vs-concentrated line: both concentrated policies are nearly all within-answered (StreamingLLM $0.749$ of ADD $0.751$; H2O-style $0.713$ of $0.715$) --- silent answer flips --- while Random and R-KV carry larger termination-mass shifts ($+0.224$ and $+0.149$). R-KV's ADD is the lowest of the four ($0.459$), coherent with its highest free-running accuracy; flip-mass is overwhelmingly toward lost correct answers for all four. Dashed line marks the two-FC noise floor ($0.068$).}}{15}{figure.caption.12}\protected@file@percent }
\newlabel{fig:add}{{5}{15}{Two failure styles that headline accuracy conflates, split along the recoverable-vs-concentrated line: both concentrated policies are nearly all within-answered (StreamingLLM $0.749$ of ADD $0.751$; H2O-style $0.713$ of $0.715$) --- silent answer flips --- while Random and R-KV carry larger termination-mass shifts ($+0.224$ and $+0.149$). R-KV's ADD is the lowest of the four ($0.459$), coherent with its highest free-running accuracy; flip-mass is overwhelmingly toward lost correct answers for all four. Dashed line marks the two-FC noise floor ($0.068$)}{figure.caption.12}{}}
\newlabel{fig:add@cref}{{[figure][5][]5}{[1][14][]15}{}{}{}}
