\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}The powered phenomenon: collapse, and random beats recency}{11}{subsection.4.2}\protected@file@percent }
\newlabel{sec:phenomenon}{{4.2}{11}{The powered phenomenon: collapse, and random beats recency}{subsection.4.2}{}}
\newlabel{sec:phenomenon@cref}{{[subsection][2][4]4.2}{[1][11][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The two protocols, side by side, on the same cells. Solid bars are free-running accuracy; hatched bars are held-trace readout accuracy on the same policy and budget. Matched full cache $0.885$ (dashed). At budget 256 the protocols disagree sharply --- free-running Random $0.422$ / StreamingLLM $0.237$ / H2O-style$^{\dagger }$ $0.247$ / R-KV$^{\ddagger }$ $0.520$, against readout $0.765$ / $0.584$ / $0.597$ / $0.798$ on the identical conditions. At budget 2048 they converge: free-running $0.850$ / $0.807$ / $0.823$ against readout $0.901$ / $0.903$ / $0.898$, at or just above the matched reference. Even the best policy at 256, the reasoning-specific R-KV, loses $0.36$ of the reference accuracy under free generation. Light tints $=$ budget 2048; $\dagger $, $\ddagger $ per \cref  {tab:decomp}. Inset: per-problem paired differences at budget 256 --- Random $-$ StreamingLLM is $+0.185$ on average (95\% CI $[0.130, 0.240]$) and non-negative on 94/100 problems (44 strict wins, 50 ties, 6 losses).}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:phenomenon}{{2}{12}{The two protocols, side by side, on the same cells. Solid bars are free-running accuracy; hatched bars are held-trace readout accuracy on the same policy and budget. Matched full cache $0.885$ (dashed). At budget 256 the protocols disagree sharply --- free-running Random $0.422$ / StreamingLLM $0.237$ / H2O-style$^{\dagger }$ $0.247$ / R-KV$^{\ddagger }$ $0.520$, against readout $0.765$ / $0.584$ / $0.597$ / $0.798$ on the identical conditions. At budget 2048 they converge: free-running $0.850$ / $0.807$ / $0.823$ against readout $0.901$ / $0.903$ / $0.898$, at or just above the matched reference. Even the best policy at 256, the reasoning-specific R-KV, loses $0.36$ of the reference accuracy under free generation. Light tints $=$ budget 2048; $\dagger $, $\ddagger $ per \cref {tab:decomp}. Inset: per-problem paired differences at budget 256 --- Random $-$ StreamingLLM is $+0.185$ on average (95\% CI $[0.130, 0.240]$) and non-negative on 94/100 problems (44 strict wins, 50 ties, 6 losses)}{figure.caption.9}{}}
\newlabel{fig:phenomenon@cref}{{[figure][2][]2}{[1][12][]12}{}{}{}}
