\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: free-running accuracy by method and budget --- the collapse is a budget effect (full cache $0.882$; at 256, Random $0.422$ / StreamingLLM $0.237$ / H2O-style$^{\dagger }$ $0.247$ / R-KV$^{\ddagger }$ $0.520$; at 2048, $0.850$ / $0.807$ / $0.823$, the near-lossless pole; light tints $=$ budget 2048; $\dagger $, $\ddagger $ per \cref  {tab:decomp}). Even the best policy at 256, the reasoning-specific R-KV, loses $0.36$ of the reference accuracy. Right: per-problem paired differences at budget 256 --- Random $-$ StreamingLLM is $+0.185$ on average (95\% CI $[0.130, 0.242]$) and non-negative on 94/100 problems (44 strict wins, 50 ties, 6 losses).}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:phenomenon}{{2}{9}{Left: free-running accuracy by method and budget --- the collapse is a budget effect (full cache $0.882$; at 256, Random $0.422$ / StreamingLLM $0.237$ / H2O-style$^{\dagger }$ $0.247$ / R-KV$^{\ddagger }$ $0.520$; at 2048, $0.850$ / $0.807$ / $0.823$, the near-lossless pole; light tints $=$ budget 2048; $\dagger $, $\ddagger $ per \cref {tab:decomp}). Even the best policy at 256, the reasoning-specific R-KV, loses $0.36$ of the reference accuracy. Right: per-problem paired differences at budget 256 --- Random $-$ StreamingLLM is $+0.185$ on average (95\% CI $[0.130, 0.242]$) and non-negative on 94/100 problems (44 strict wins, 50 ties, 6 losses)}{figure.caption.6}{}}
\newlabel{fig:phenomenon@cref}{{[figure][2][]2}{[1][9][]9}{}{}{}}
