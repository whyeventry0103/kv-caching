\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Accuracy ladders from the matched full-cache reference ($0.885$) down through forward readout, reverse readout, and free-run, per policy --- top row the \emph  {recoverable} pair (Random, R-KV), bottom row the \emph  {concentrated} pair (StreamingLLM, H2O-style), the reverse-side split of \cref  {sec:reverse}. The arrow marks the forward trajectory residual (the free-run--to--readout gap); whiskers on the forward-readout rung are its problem-clustered 95\% accuracy CI. The residual brackets (Random $[-0.337, -0.282]$, R-KV $[-0.268, -0.251]$, StreamingLLM $[-0.470, -0.344]$, H2O-style $[-0.478, -0.344]$) and the 95\% CIs on all eight endpoints (beneath each panel) exclude zero: even the best free-runner leaves a large, readout-invisible residual, and the concentrated policies' traces resist even clean full-cache readout.}}{16}{figure.caption.11}\protected@file@percent }
\newlabel{fig:bracket}{{3}{16}{Accuracy ladders from the matched full-cache reference ($0.885$) down through forward readout, reverse readout, and free-run, per policy --- top row the \emph {recoverable} pair (Random, R-KV), bottom row the \emph {concentrated} pair (StreamingLLM, H2O-style), the reverse-side split of \cref {sec:reverse}. The arrow marks the forward trajectory residual (the free-run--to--readout gap); whiskers on the forward-readout rung are its problem-clustered 95\% accuracy CI. The residual brackets (Random $[-0.337, -0.282]$, R-KV $[-0.268, -0.251]$, StreamingLLM $[-0.470, -0.344]$, H2O-style $[-0.478, -0.344]$) and the 95\% CIs on all eight endpoints (beneath each panel) exclude zero: even the best free-runner leaves a large, readout-invisible residual, and the concentrated policies' traces resist even clean full-cache readout}{figure.caption.11}{}}
\newlabel{fig:bracket@cref}{{[figure][3][]3}{[1][15][]16}{}{}{}}
